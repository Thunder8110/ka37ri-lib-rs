      "fn accumulate<T>(",
      "  iter: impl Iterator<Item = T>,",
      "  init: T,",
      "  unit: T,",
      "  func: fn(T, T) -> T,",
      ") -> impl Iterator<Item = T>",
      "where",
      "  T: Clone,",
      "{",
      "  std::iter::once(unit).chain(iter).scan(init, move |acc, x| {",
      "    *acc = func(acc.clone(), x);",
      "    Some(acc.clone())",
      "  })",
      "}"
    ]
  },
  "bsi": {
    "prefix": "bsi",
    "body": [
      "fn binary_search_integer(left: u64, right: u64, pred: fn(u64) -> bool) -> u64 {",
      "  let mut l = left;",
      "  let mut r = right;",
      "  while r - l > 1 {",
      "    let m = l + (r - l) / 2;",
      "    if pred(m) {",
      "      l = m;",
      "    } else {",
      "      r = m;",
      "    }",
      "  }",
      "  l",
      "}"
    ]
  },
  "bssr": {
    "prefix": "bssr",
    "body": [
      "fn bs_sqrt(n: i64) -> i64 {",
      "  let mut right = 1;",
      "  while right * right < n {",
      "    right <<= 1;",
      "    if right >= (1 << 31) {",
      "      right = 3037000500;",
      "      break;",
      "    }",
      "  }",
      "  let mut left = right >> 1;",
      "  while right - left > 1 {",
      "    let mid = (left + right) / 2;",
      "    let m_sq = mid * mid;",
      "    if m_sq == n {",
      "      return mid;",
      "    } else if m_sq > n {",
      "      right = mid;",
      "    } else {",
      "      left = mid;",
      "    }",
      "  }",
      "  left",
      "}"
    ]
  },
