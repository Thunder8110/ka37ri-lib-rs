{
  "acc": {
    "prefix": "acc",
    "body": [
      "fn accumulate<T>(",
      "  iter: impl Iterator<Item = T>,",
      "  init: T,",
      "  unit: T,",
      "  func: fn(T, T) -> T,",
      ") -> impl Iterator<Item = T>",
      "where",
      "  T: Clone,",
      "{",
      "  std::iter::once(unit).chain(iter).scan(init, move |acc, x| {",
      "    *acc = func(acc.clone(), x);",
      "    Some(acc.clone())",
      "  })",
      "}"
    ]
  },
  "bsi": {
    "prefix": "bsi",
    "body": [
      "fn binary_search_integer(left: u64, right: u64, pred: fn(u64) -> bool) -> u64 {",
      "  let mut l = left;",
      "  let mut r = right;",
      "  while r - l > 1 {",
      "    let m = l + (r - l) / 2;",
      "    if pred(m) {",
      "      l = m;",
      "    } else {",
      "      r = m;",
      "    }",
      "  }",
      "  l",
      "}"
    ]
  },
  "bssr": {
    "prefix": "bssr",
    "body": [
      "fn bs_sqrt(n: i64) -> i64 {",
      "  let mut right = 1;",
      "  while right * right < n {",
      "    right <<= 1;",
      "    if right >= (1 << 31) {",
      "      right = 3037000500;",
      "      break;",
      "    }",
      "  }",
      "  let mut left = right >> 1;",
      "  while right - left > 1 {",
      "    let mid = (left + right) / 2;",
      "    let m_sq = mid * mid;",
      "    if m_sq == n {",
      "      return mid;",
      "    } else if m_sq > n {",
      "      right = mid;",
      "    } else {",
      "      left = mid;",
      "    }",
      "  }",
      "  left",
      "}"
    ]
  },
  "dijk": {
    "prefix": "dijk",
    "body": [
      "fn dijkstra(n: usize, graph: &Vec<Vec<(usize, u64)>>, s: usize) -> Vec<u64> {",
      "  let mut queue = BinaryHeap::new();",
      "  queue.push(Reverse((0, s)));",
      "  let mut visited = vec![false; n];",
      "  let mut dist = vec![u64::MAX; n];",
      "  while let Some(Reverse((cc, cv))) = queue.pop() {",
      "    if visited[cv] {",
      "      continue;",
      "    }",
      "    visited[cv] = true;",
      "    dist[cv] = cc;",
      "    for &(nxv, nxc) in graph[cv].iter() {",
      "      if visited[nxv] {",
      "        continue;",
      "      }",
      "      queue.push(Reverse((cc + nxc, nxv)));",
      "    }",
      "  }",
      "  dist",
      "}"
    ]
  },
  "ert": {
    "prefix": "ert",
    "body": [
      "fn eratosthenes(n: usize) -> Vec<usize> {",
      "  let mut arr = vec![true; n + 1];",
      "  arr[0] = false;",
      "  arr[1] = false;",
      "  let mut i = 2;",
      "  while i * i <= n {",
      "    if arr[i] {",
      "      for x in i..=(n / i) {",
      "        arr[i * x] = false;",
      "      }",
      "    }",
      "    i += 1;",
      "  }",
      "  let mut primes = Vec::new();",
      "  for j in 0..=n {",
      "    if arr[j] {",
      "      primes.push(j);",
      "    }",
      "  }",
      "  primes",
      "}"
    ]
  },
  "euc": {
    "prefix": "euc",
    "body": [
      "fn ext_euc_pos(a: i64, b: i64) -> (i64, i64, i64) {",
      "  assert!(a > 0 && b > 0);",
      "  let (mut xp, mut xc) = (1, 0);",
      "  let (mut yp, mut yc) = (0, 1);",
      "  let (mut zp, mut zc) = (a, b);",
      "  loop {",
      "    let q = zp / zc;",
      "    (zp, zc) = (zc, zp - q * zc);",
      "    if zc == 0 {",
      "      break (xc, yc, zp);",
      "    }",
      "    (xp, xc) = (xc, xp - q * xc);",
      "    (yp, yc) = (yc, yp - q * yc);",
      "  }",
      "}",
      "fn ext_euc(a: i64, b: i64) -> (i64, i64, i64) {",
      "  assert!(a != 0 && b != 0);",
      "  let (x, y, z) = ext_euc_pos(a.abs(), b.abs());",
      "  match (a.cmp(&0), b.cmp(&0)) {",
      "    (Ordering::Greater, Ordering::Greater) => (x, y, z),",
      "    (Ordering::Greater, Ordering::Less) => (x, -y, z),",
      "    (Ordering::Less, Ordering::Greater) => (-x, y, z),",
      "    (Ordering::Less, Ordering::Less) => (-x, -y, z),",
      "    _ => panic!(),",
      "  }",
      "}"
    ]
  },
