      "fn run_length(s: String) -> Vec<(char, usize)> {",
      "  let mut chs = s.chars();",
      "  let mut res = Vec::new();",
      "  let mut curr = chs.nth(0).unwrap();",
      "  let mut num = 1;",
      "  for c in chs {",
      "    if c == curr {",
      "      num += 1;",
      "    } else {",
      "      res.push((curr, num));",
      "      curr = c;",
      "      num = 1;",
      "    }",
      "  }",
      "  res.push((curr, num));",
      "  res",
      "}"
    ]
