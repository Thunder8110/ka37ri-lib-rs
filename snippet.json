  "pf": {
    "prefix": "pf",
    "body": [
      "fn prime_factor(n: i64) -> Vec<(i64, u32)> {",
      "  let mut x = n;",
      "  let mut res = Vec::new();",
      "  for i in 2..n {",
      "    let mut e = 0;",
      "    if i * i > n {",
      "      break;",
      "    }",
      "    while x % i == 0 {",
      "      x /= i;",
      "      e += 1;",
      "    }",
      "    if e > 0 {",
      "      res.push((i, e))",
      "    }",
      "  }",
      "  if x > 1 {",
      "    res.push((x, 1));",
      "  }",
      "  res",
      "}"
    ]
  },
  "rl": {
    "prefix": "rl",
    "body": [
      "fn run_length(s: String) -> Vec<(char, usize)> {",
      "  let mut chs = s.chars();",
      "  let mut res = Vec::new();",
      "  let mut curr = chs.nth(0).unwrap();",
      "  let mut num = 1;",
      "  for c in chs {",
      "    if c == curr {",
      "      num += 1;",
      "    } else {",
      "      res.push((curr, num));",
      "      curr = c;",
      "      num = 1;",
      "    }",
      "  }",
      "  res.push((curr, num));",
      "  res",
      "}"
    ]
  }
