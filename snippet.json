    "body": [
      "fn two_dimensional_prefix_sum(arr: &[Vec<i64>]) -> Vec<Vec<i64>> {",
      "  let h = arr.len();",
      "  let w = arr[0].len();",
      "  let mut psum = vec![vec![0; w + 1]; h + 1];",
      "  for i in 0..h {",
      "    for j in 0..w {",
      "      psum[i + 1][j + 1] = arr[i][j] + psum[i + 1][j] + psum[i][j + 1] - psum[i][j];",
      "    }",
      "  }",
      "  psum",
      "}"
    ]
  },
