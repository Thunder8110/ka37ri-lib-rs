  "rh": {
    "prefix": "rh",
    "body": [
      "pub mod rolling_hash {",
      "  use std::ops::Range;",
      "  #[derive(Debug)]",
      "  pub struct RHBase<T> {",
      "    base: u128,",
      "    modulo: u128,",
      "    power: Vec<u64>,",
      "    func: fn(T) -> u64,",
      "  }",
      "  impl<T> RHBase<T>",
      "  where",
      "    T: Clone,",
      "  {",
      "    pub fn new(base: u128, modulo: u128, func: fn(T) -> u64) -> Self {",
      "      RHBase {",
      "        base,",
      "        modulo,",
      "        power: vec![1],",
      "        func,",
      "      }",
      "    }",
      "    fn pow(&mut self, n: usize) -> u64 {",
      "      while self.power.len() <= n {",
      "        let p = (*self.power.last().unwrap() as u128 * self.base) % self.modulo;",
      "        self.power.push(p as u64);",
      "      }",
      "      self.power[n]",
      "    }",
      "  }",
      "  #[derive(Debug)]",
      "  pub struct RollingHash<T> {",
      "    rh_base: Box<RHBase<T>>,",
      "    hash: Vec<u64>,",
      "  }",
      "  impl<T> RollingHash<T>",
      "  where",
      "    T: Clone,",
      "  {",
      "    pub fn new(rh_base: Box<RHBase<T>>) -> Self {",
      "      RollingHash {",
      "        rh_base,",
      "        hash: vec![0],",
      "      }",
      "    }",
      "    pub fn new_with(rh_base: Box<RHBase<T>>, s: &[T]) -> Self {",
      "      let mut rh = RollingHash::new(rh_base);",
      "      rh.build(s);",
      "      rh",
      "    }",
      "    fn build(&mut self, s: &[T]) {",
      "      let mut hash = vec![0; s.len() + 1];",
      "      for i in 0..s.len() {",
      "        let h = hash[i] as u128 * self.rh_base.base + (self.rh_base.func)(s[i].clone()) as u128;",
      "        hash[i + 1] = (h % self.rh_base.modulo) as u64;",
      "      }",
      "      self.hash = hash;",
      "    }",
      "    pub fn get(&mut self, range: Range<usize>) -> u64 {",
      "      let st = self.hash[range.start] as u128 * self.rh_base.pow(range.end - range.start) as u128;",
      "      let h = self.hash[range.end] as u128 + self.rh_base.modulo - (st % self.rh_base.modulo);",
      "      (h % self.rh_base.modulo) as u64",
      "    }",
      "    pub fn len(&self) -> usize {",
      "      self.hash.len() - 1",
      "    }",
      "    pub fn push(&mut self, x: T) {",
      "      let h =",
      "        *self.hash.last().unwrap() as u128 * self.rh_base.base + (self.rh_base.func)(x) as u128;",
      "      self.hash.push((h % self.rh_base.modulo) as u64);",
      "    }",
      "  }",
      "}"
    ]
  },
  "rl": {
    "prefix": "rl",
    "body": [
      "fn run_length<T: Eq + Clone>(seq: impl IntoIterator<Item = T>) -> Vec<(T, usize)> {",
      "  let mut itr = seq.into_iter().peekable();",
      "  let mut res = Vec::new();",
      "  let mut curr = itr.peek().unwrap().clone();",
      "  let mut num = 0;",
      "  for c in itr {",
      "    if c == curr {",
      "      num += 1;",
      "    } else {",
      "      res.push((curr, num));",
      "      curr = c;",
      "      num = 1;",
      "    }",
      "  }",
      "  res.push((curr, num));",
      "  res",
      "}"
    ]
  },
  "s2i": {
    "prefix": "s2i",
    "body": [
      "fn str_to_int_pos(s: &str, b: i64) -> i64 {",
      "  assert!(2 <= b && b <= 36, \"base must be between 2 and 36\");",
      "  assert!(",
      "    s.chars()",
      "      .all(|c| c.is_digit(b as u32) || c.is_ascii_alphabetic()),",
      "    \"invalid character\"",
      "  );",
      "  let chars = s.chars();",
      "  let mut res = 0;",
      "  for c in chars {",
      "    let d = match c {",
      "      '0'..='9' => c as i64 - '0' as i64,",
      "      'A'..='Z' => c as i64 - 'A' as i64 + 10,",
      "      _ => panic!(\"invalid character\"),",
      "    };",
      "    assert!(d < b, \"invalid character\");",
      "    res = res * b + d;",
      "  }",
      "  res",
      "}",
      "fn str_to_int(s: String, b: i64) -> i64 {",
      "  if s.starts_with('-') {",
      "    -str_to_int_pos(&s[1..], b)",
      "  } else if s.starts_with('+') {",
      "    str_to_int_pos(&s[1..], b)",
      "  } else {",
      "    str_to_int_pos(&s, b)",
      "  }",
      "}"
    ]
  },
