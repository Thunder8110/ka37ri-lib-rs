      "fn binary_search_integer(left: u64, right: u64, pred: fn(u64) -> bool) -> u64 {",
      "  let mut l = left;",
      "  let mut r = right;",
      "  while r - l > 1 {",
      "    let m = l + (r - l) / 2;",
      "    if pred(m) {",
      "      l = m;",
      "    } else {",
      "      r = m;",
      "    }",
      "  }",
      "  l",
      "}"
    ]
