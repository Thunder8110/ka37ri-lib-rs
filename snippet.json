    "body": [
      "fn pattern_range_sum(patt: &[(i64, usize)], n: usize) -> i64 {",
      "  let sm = patt.iter().map(|&(x, y)| x * y as i64).sum::<i64>();",
      "  let sz = patt.iter().map(|&(_, y)| y).sum::<usize>();",
      "  let mut res = sm * (n as i64 / sz as i64);",
      "  let mut rem = n % sz;",
      "  for &(x, y) in patt.iter() {",
      "    if rem < y {",
      "      res += x * rem as i64;",
      "      break;",
      "    } else {",
      "      res += x * y as i64;",
      "      rem -= y;",
      "    }",
      "  }",
      "  res",
      "}"
    ]
  },
