      "  for i in 2..n {",
      "    let mut e = 0;",
      "    if i * i > n {",
      "      break;",
      "    }",
      "    while x % i == 0 {",
      "      x /= i;",
      "      e += 1;",
      "    }",
      "    if e > 0 {",
      "      res.push((i, e))",
      "    }",
      "  }",
      "  if x > 1 {",
      "    res.push((x, 1));",
      "  }",
      "  res",
      "}"
