      "  use std::ops::{Index, IndexMut, RangeInclusive};",
      "  #[derive(Debug, Clone, PartialEq, Eq)]",
      "  pub struct CharRangeVec<V> {",
      "    vec: Vec<V>,",
      "    range: RangeInclusive<char>,",
