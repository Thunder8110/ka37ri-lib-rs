    "body": [
      "use num::One;",
      "use std::ops::Mul;",
      "pub fn pow_mod<T: Clone + One + Mul<T, Output = T> + TryInto<u128> + TryFrom<u128> + Default>(",
      "  base: T,",
      "  mut exp: usize,",
      "  md: T,",
      ") -> T {",
      "  if exp == 0 {",
      "    return T::one();",
      "  }",
      "  let mut base: u128 = base.try_into().unwrap_or_default();",
      "  let md: u128 = md.try_into().unwrap_or_default();",
      "  while exp & 1 == 0 {",
      "    base = base.clone() * base % md;",
      "    exp >>= 1;",
      "  }",
      "  if exp == 1 {",
      "    return base.try_into().unwrap_or_default();",
      "  }",
      "  let mut acc = base.clone();",
      "  while exp > 1 {",
      "    exp >>= 1;",
      "    base = base.clone() * base % md;",
      "    if exp & 1 == 1 {",
      "      acc = acc * base.clone() % md;",
      "    }",
      "  }",
      "  acc.try_into().unwrap_or_default()",
      "}"
    ]
  },
  "prs": {
